ARG POSTHOG_IMAGE=posthog/posthog@sha256:51b5d173a563840a7f58defdb75827b4670c9c2cac7a109d94fcf8f8776eaee1
FROM ${POSTHOG_IMAGE} AS upstream

FROM ${POSTHOG_IMAGE} AS python-runtime-slim

# Remove bytecode caches before copying the runtime into the final image.
RUN find /python-runtime -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete && \
    find /python-runtime -type d -name __pycache__ -prune -exec rm -rf {} +

# Match the interpreter ABI used by upstream's /python-runtime virtualenv.
FROM python:3.14.7-slim-bookworm@sha256:9ab8d9c8514b44f90cf0029dd42fdd7e9e211e639c8b995304cc04568dee900f

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUTF8=1 \
    LANG=C.UTF-8 \
    TIKTOKEN_CACHE_DIR=/code/.tiktoken_cache \
    PATH=/python-runtime/bin:$PATH \
    PYTHONPATH=/python-runtime \
    NODE_ENV=production

COPY images/debian.sources /etc/apt/sources.list.d/debian.sources
RUN apt-get update && \
    apt-get install -y --no-install-recommends --allow-downgrades \
    ca-certificates \
    git \
    libjemalloc2 \
    libpq5 \
    libxml2 \
    libxmlsec1=1.2.37-2 \
    libxmlsec1-openssl=1.2.37-2 \
    libssl3=3.0.* \
    libatomic1 \
    libgomp1 \
    media-types \
    tzdata \
    && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -g 1000 posthog && \
    useradd -m -u 1000 -g posthog posthog

WORKDIR /code

# Runtime Python environment and Django app code.
COPY --from=python-runtime-slim --chown=posthog:posthog /python-runtime /python-runtime
COPY --from=upstream --chown=posthog:posthog /code/bin /code/bin
COPY --from=upstream --chown=posthog:posthog /code/commit.txt /code/commit.txt
COPY --from=upstream --chown=posthog:posthog /code/manage.py /code/manage.py
COPY --from=upstream --chown=posthog:posthog /code/posthog /code/posthog
COPY --from=upstream --chown=posthog:posthog /code/ee /code/ee
COPY --from=upstream --chown=posthog:posthog /code/common/hogvm /code/common/hogvm
COPY --from=upstream --chown=posthog:posthog /code/common/migration_utils /code/common/migration_utils
COPY --from=upstream --chown=posthog:posthog /code/products /code/products
# Conversations email: let MAILGUN_API_BASE point at a Mailgun-compatible API (integrations/cloudflare-email).
RUN sed -i 's|^MAILGUN_API_BASE = "https://api.mailgun.net/v3"$|MAILGUN_API_BASE = __import__("os").environ.get("MAILGUN_API_BASE", "https://api.mailgun.net/v3")|' /code/products/conversations/backend/mailgun.py && \
    grep -q 'environ.get("MAILGUN_API_BASE"' /code/products/conversations/backend/mailgun.py
COPY --from=upstream --chown=posthog:posthog /code/packages/owners-yaml /code/packages/owners-yaml
COPY --from=upstream --chown=posthog:posthog /code/services/mcp/schema /code/services/mcp/schema
COPY --from=upstream --chown=posthog:posthog /code/services/mcp/dist/cli-catalog.json /code/services/mcp/dist/cli-catalog.json
COPY --from=upstream --chown=posthog:posthog /code/share/GeoLite2-City.mmdb /code/share/GeoLite2-City.mmdb
COPY --from=upstream --chown=posthog:posthog /code/.tiktoken_cache /code/.tiktoken_cache

# Built frontend assets. Django templates resolve from frontend/dist, while the
# staticfiles tree serves the hashed asset paths generated from the same build.
# Preserve upstream's sourcemap retention decision when upload was unavailable.
COPY --from=upstream --chown=posthog:posthog /code/frontend/dist /code/frontend/dist
COPY --from=upstream --chown=posthog:posthog /code/staticfiles /code/staticfiles
COPY --from=upstream --chown=posthog:posthog /code/frontend/src/products.json /code/frontend/src/products.json

# The Django plugin/site-app transpiler shells out to Node.
COPY --from=upstream --chown=posthog:posthog /code/common/plugin_transpiler /code/common/plugin_transpiler
COPY --from=upstream /usr/local/bin/node /usr/local/bin/node
RUN ln -s /usr/local/bin/node /usr/local/bin/nodejs

# Share the chart's migration gate and non-root Granian/metrics lifecycle.
COPY --chown=posthog:posthog charts/posthog/files/web-startup.sh /code/bin/docker-server

USER posthog

EXPOSE 8000
EXPOSE 8001

CMD ["bash", "./bin/docker-server"]

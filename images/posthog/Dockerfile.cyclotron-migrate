# posthog-cyclotron-migrate
#
# A small image that runs PostHog's cyclotron sqlx migrations. The runtime
# PostHog images (posthog/posthog, posthog-node, the cyclotron service images)
# do NOT ship sqlx-cli or the cyclotron migrations, so there is no in-image way
# to create/migrate the cyclotron + cyclotron_node databases. This image bundles
# sqlx-cli + the vendored cyclotron-core migrations and is run as a Helm
# pre-upgrade hook (charts/posthog/templates/hooks/cyclotron-migrate.job.yaml),
# mirroring upstream's rust/bin/migrate-cyclotron[-node] (sqlx database create +
# sqlx migrate run).
#
# POSTHOG_IMAGE build-arg is accepted (passed by the shared build matrix) but
# unused here.
ARG POSTHOG_IMAGE=posthog/posthog:latest

FROM rust:1.91-slim-bookworm AS sqlx-builder
ARG SQLX_CLI_VERSION=0.8.3
RUN apt-get update \
 && apt-get install -y --no-install-recommends pkg-config libssl-dev \
 && rm -rf /var/lib/apt/lists/* \
 && cargo install sqlx-cli --version "${SQLX_CLI_VERSION}" \
      --no-default-features --features rustls,postgres --root /opt/sqlx

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libssl3 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -g 1000 posthog \
 && useradd -m -u 1000 -g posthog posthog
COPY --from=sqlx-builder /opt/sqlx/bin/sqlx /usr/local/bin/sqlx
COPY images/posthog/cyclotron-migrations/ /migrations/
COPY images/posthog/cyclotron-migrate-entrypoint.sh /usr/local/bin/cyclotron-migrate
RUN chmod +x /usr/local/bin/cyclotron-migrate
USER posthog
ENTRYPOINT ["/usr/local/bin/cyclotron-migrate"]

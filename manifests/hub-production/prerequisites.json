{
  "purpose": "Inventory only; not a Kustomize resource. Install shared services separately before namespace profile.",
  "controllers": [
    {
      "kind": "Deployment",
      "namespace": "cert-manager",
      "name": "cert-manager",
      "chart": "cert-manager-v1.17.2",
      "replicas": 1,
      "serviceAccountName": "cert-manager",
      "containers": [
        {
          "name": "cert-manager-controller",
          "image": "quay.io/jetstack/cert-manager-controller:v1.17.2",
          "args": [
            "--v=2",
            "--cluster-resource-namespace=$(POD_NAMESPACE)",
            "--leader-election-namespace=kube-system",
            "--acme-http01-solver-image=quay.io/jetstack/cert-manager-acmesolver:v1.17.2",
            "--default-issuer-name=letsencrypt-prod",
            "--default-issuer-kind=ClusterIssuer",
            "--default-issuer-group=cert-manager.io",
            "--max-concurrent-challenges=60"
          ],
          "env": [
            {
              "name": "POD_NAMESPACE",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "metadata.namespace"
                }
              }
            }
          ]
        }
      ],
      "configMaps": []
    },
    {
      "kind": "Deployment",
      "namespace": "cert-manager",
      "name": "cert-manager-cainjector",
      "chart": "cert-manager-v1.17.2",
      "replicas": 1,
      "serviceAccountName": "cert-manager-cainjector",
      "containers": [
        {
          "name": "cert-manager-cainjector",
          "image": "quay.io/jetstack/cert-manager-cainjector:v1.17.2",
          "args": [
            "--v=2",
            "--leader-election-namespace=kube-system"
          ],
          "env": [
            {
              "name": "POD_NAMESPACE",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "metadata.namespace"
                }
              }
            }
          ]
        }
      ],
      "configMaps": []
    },
    {
      "kind": "Deployment",
      "namespace": "cert-manager",
      "name": "cert-manager-webhook",
      "chart": "cert-manager-v1.17.2",
      "replicas": 1,
      "serviceAccountName": "cert-manager-webhook",
      "containers": [
        {
          "name": "cert-manager-webhook",
          "image": "quay.io/jetstack/cert-manager-webhook:v1.17.2",
          "args": [
            "--v=2",
            "--secure-port=10250",
            "--dynamic-serving-ca-secret-namespace=$(POD_NAMESPACE)",
            "--dynamic-serving-ca-secret-name=cert-manager-webhook-ca",
            "--dynamic-serving-dns-names=cert-manager-webhook",
            "--dynamic-serving-dns-names=cert-manager-webhook.$(POD_NAMESPACE)",
            "--dynamic-serving-dns-names=cert-manager-webhook.$(POD_NAMESPACE).svc"
          ],
          "env": [
            {
              "name": "POD_NAMESPACE",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "metadata.namespace"
                }
              }
            }
          ]
        }
      ],
      "configMaps": []
    },
    {
      "kind": "Deployment",
      "namespace": "cnpg-system",
      "name": "cnpg-controller-manager",
      "chart": null,
      "replicas": 1,
      "serviceAccountName": "cnpg-manager",
      "containers": [
        {
          "name": "manager",
          "image": "ghcr.io/cloudnative-pg/cloudnative-pg:1.29.0",
          "command": [
            "/manager"
          ],
          "args": [
            "controller",
            "--leader-elect",
            "--max-concurrent-reconciles=10",
            "--config-map-name=cnpg-controller-manager-config",
            "--secret-name=cnpg-controller-manager-config",
            "--webhook-port=9443"
          ],
          "env": [
            {
              "name": "OPERATOR_IMAGE_NAME",
              "value": "ghcr.io/cloudnative-pg/cloudnative-pg:1.29.0"
            },
            {
              "name": "OPERATOR_NAMESPACE",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "metadata.namespace"
                }
              }
            },
            {
              "name": "MONITORING_QUERIES_CONFIGMAP",
              "value": "cnpg-default-monitoring"
            }
          ]
        }
      ],
      "configMaps": []
    },
    {
      "kind": "Deployment",
      "namespace": "flux-system",
      "name": "helm-controller",
      "chart": null,
      "replicas": 1,
      "serviceAccountName": "helm-controller",
      "containers": [
        {
          "name": "manager",
          "image": "ghcr.io/fluxcd/helm-controller:v1.3.0",
          "args": [
            "--events-addr=http://notification-controller.flux-system.svc.cluster.local./",
            "--watch-all-namespaces=true",
            "--log-level=info",
            "--log-encoding=json",
            "--enable-leader-election"
          ],
          "env": [
            {
              "name": "RUNTIME_NAMESPACE",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "metadata.namespace"
                }
              }
            },
            {
              "name": "GOMAXPROCS",
              "valueFrom": {
                "resourceFieldRef": {
                  "containerName": "manager",
                  "resource": "limits.cpu",
                  "divisor": "0"
                }
              }
            },
            {
              "name": "GOMEMLIMIT",
              "valueFrom": {
                "resourceFieldRef": {
                  "containerName": "manager",
                  "resource": "limits.memory",
                  "divisor": "0"
                }
              }
            }
          ]
        }
      ],
      "configMaps": []
    },
    {
      "kind": "Deployment",
      "namespace": "flux-system",
      "name": "kustomize-controller",
      "chart": null,
      "replicas": 1,
      "serviceAccountName": "kustomize-controller",
      "containers": [
        {
          "name": "manager",
          "image": "ghcr.io/fluxcd/kustomize-controller:v1.6.1",
          "args": [
            "--events-addr=http://notification-controller.flux-system.svc.cluster.local./",
            "--watch-all-namespaces=true",
            "--log-level=info",
            "--log-encoding=json",
            "--enable-leader-election"
          ],
          "env": [
            {
              "name": "RUNTIME_NAMESPACE",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "metadata.namespace"
                }
              }
            },
            {
              "name": "GOMAXPROCS",
              "valueFrom": {
                "resourceFieldRef": {
                  "containerName": "manager",
                  "resource": "limits.cpu",
                  "divisor": "0"
                }
              }
            },
            {
              "name": "GOMEMLIMIT",
              "valueFrom": {
                "resourceFieldRef": {
                  "containerName": "manager",
                  "resource": "limits.memory",
                  "divisor": "0"
                }
              }
            }
          ]
        }
      ],
      "configMaps": []
    },
    {
      "kind": "Deployment",
      "namespace": "flux-system",
      "name": "source-controller",
      "chart": null,
      "replicas": 1,
      "serviceAccountName": "source-controller",
      "containers": [
        {
          "name": "manager",
          "image": "ghcr.io/fluxcd/source-controller:v1.6.2",
          "args": [
            "--events-addr=http://notification-controller.flux-system.svc.cluster.local./",
            "--watch-all-namespaces=true",
            "--log-level=info",
            "--log-encoding=json",
            "--enable-leader-election",
            "--storage-path=/data",
            "--storage-adv-addr=source-controller.$(RUNTIME_NAMESPACE).svc.cluster.local."
          ],
          "env": [
            {
              "name": "RUNTIME_NAMESPACE",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "metadata.namespace"
                }
              }
            },
            {
              "name": "TUF_ROOT",
              "value": "/tmp/.sigstore"
            },
            {
              "name": "GOMAXPROCS",
              "valueFrom": {
                "resourceFieldRef": {
                  "containerName": "manager",
                  "resource": "limits.cpu",
                  "divisor": "0"
                }
              }
            },
            {
              "name": "GOMEMLIMIT",
              "valueFrom": {
                "resourceFieldRef": {
                  "containerName": "manager",
                  "resource": "limits.memory",
                  "divisor": "0"
                }
              }
            }
          ]
        }
      ],
      "configMaps": []
    },
    {
      "kind": "Deployment",
      "namespace": "posthog",
      "name": "clickhouse-operator-altinity-clickhouse-operator",
      "chart": "altinity-clickhouse-operator-0.26.1",
      "replicas": 1,
      "serviceAccountName": "clickhouse-operator-altinity-clickhouse-operator",
      "containers": [
        {
          "name": "altinity-clickhouse-operator",
          "image": "altinity/clickhouse-operator:0.26.1",
          "env": [
            {
              "name": "OPERATOR_POD_NODE_NAME",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "spec.nodeName"
                }
              }
            },
            {
              "name": "OPERATOR_POD_NAME",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "metadata.name"
                }
              }
            },
            {
              "name": "OPERATOR_POD_NAMESPACE",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "metadata.namespace"
                }
              }
            },
            {
              "name": "OPERATOR_POD_IP",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "status.podIP"
                }
              }
            },
            {
              "name": "OPERATOR_POD_SERVICE_ACCOUNT",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "spec.serviceAccountName"
                }
              }
            },
            {
              "name": "OPERATOR_CONTAINER_CPU_REQUEST",
              "valueFrom": {
                "resourceFieldRef": {
                  "containerName": "altinity-clickhouse-operator",
                  "resource": "requests.cpu",
                  "divisor": "0"
                }
              }
            },
            {
              "name": "OPERATOR_CONTAINER_CPU_LIMIT",
              "valueFrom": {
                "resourceFieldRef": {
                  "containerName": "altinity-clickhouse-operator",
                  "resource": "limits.cpu",
                  "divisor": "0"
                }
              }
            },
            {
              "name": "OPERATOR_CONTAINER_MEM_REQUEST",
              "valueFrom": {
                "resourceFieldRef": {
                  "containerName": "altinity-clickhouse-operator",
                  "resource": "requests.memory",
                  "divisor": "0"
                }
              }
            },
            {
              "name": "OPERATOR_CONTAINER_MEM_LIMIT",
              "valueFrom": {
                "resourceFieldRef": {
                  "containerName": "altinity-clickhouse-operator",
                  "resource": "limits.memory",
                  "divisor": "0"
                }
              }
            }
          ]
        }
      ],
      "configMaps": [
        "clickhouse-operator-altinity-clickhouse-operator-files",
        "clickhouse-operator-altinity-clickhouse-operator-confd-files",
        "clickhouse-operator-altinity-clickhouse-operator-configd-files",
        "clickhouse-operator-altinity-clickhouse-operator-templatesd-files",
        "clickhouse-operator-altinity-clickhouse-operator-usersd-files",
        "clickhouse-operator-altinity-clickhouse-operator-keeper-confd-files",
        "clickhouse-operator-altinity-clickhouse-operator-keeper-configd-files",
        "clickhouse-operator-altinity-clickhouse-operator-keeper-templatesd-files",
        "clickhouse-operator-altinity-clickhouse-operator-keeper-usersd-files"
      ]
    },
    {
      "kind": "Deployment",
      "namespace": "posthog",
      "name": "redpanda-operator",
      "chart": "operator-26.1.2",
      "replicas": 1,
      "serviceAccountName": "redpanda-operator",
      "containers": [
        {
          "name": "manager",
          "image": "docker.redpanda.com/redpandadata/redpanda-operator:v26.1.2",
          "command": [
            "/manager"
          ],
          "args": [
            "--configurator-base-image=docker.redpanda.com/redpandadata/redpanda-operator",
            "--configurator-tag=v26.1.2",
            "--enable-console=true",
            "--enable-vectorized-controllers=false",
            "--health-probe-bind-address=:8081",
            "--leader-elect",
            "--log-level=info",
            "--metrics-bind-address=:8443",
            "--webhook-enabled=false"
          ]
        }
      ],
      "configMaps": []
    },
    {
      "kind": "Deployment",
      "namespace": "traefik",
      "name": "traefik",
      "chart": "traefik-26.0.0",
      "replicas": 2,
      "serviceAccountName": "traefik",
      "containers": [
        {
          "name": "traefik",
          "image": "docker.io/traefik:v2.10.6",
          "args": [
            "--global.checknewversion",
            "--global.sendanonymoususage",
            "--entrypoints.metrics.address=:9100/tcp",
            "--entrypoints.traefik.address=:9000/tcp",
            "--entrypoints.web.address=:8000/tcp",
            "--entrypoints.websecure.address=:8443/tcp",
            "--api.dashboard=true",
            "--ping=true",
            "--metrics.prometheus=true",
            "--metrics.prometheus.entrypoint=metrics",
            "--providers.kubernetescrd",
            "--providers.kubernetesingress",
            "--entrypoints.websecure.http.tls=true",
            "--experimental.http3=true",
            "--entrypoints.websecure.http3",
            "--entrypoints.websecure.http3.advertisedPort=443",
            "--entrypoints.websecure.forwardedHeaders.insecure"
          ],
          "env": [
            {
              "name": "POD_NAME",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "metadata.name"
                }
              }
            },
            {
              "name": "POD_NAMESPACE",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "metadata.namespace"
                }
              }
            }
          ]
        }
      ],
      "configMaps": []
    },
    {
      "kind": "StatefulSet",
      "namespace": "elastic-system",
      "name": "elastic-operator",
      "chart": null,
      "replicas": 1,
      "serviceAccountName": "elastic-operator",
      "containers": [
        {
          "name": "manager",
          "image": "docker.elastic.co/eck/eck-operator:2.7.0",
          "args": [
            "manager",
            "--config=/conf/eck.yaml"
          ],
          "env": [
            {
              "name": "OPERATOR_NAMESPACE",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "metadata.namespace"
                }
              }
            },
            {
              "name": "POD_IP",
              "valueFrom": {
                "fieldRef": {
                  "apiVersion": "v1",
                  "fieldPath": "status.podIP"
                }
              }
            },
            {
              "name": "WEBHOOK_SECRET",
              "value": "elastic-webhook-server-cert"
            }
          ]
        }
      ],
      "configMaps": [
        "elastic-operator"
      ]
    }
  ],
  "configurationSources": {
    "altinity": "https://helm.altinity.com (altinity-clickhouse-operator chart 0.26.1)",
